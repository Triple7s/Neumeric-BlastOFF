#SFXSlider Label {
    display: flex;
    background-image: url("project://database/Assets/UI/Images/Speaking.png?fileID=21300000&guid=e5c6be9f18e324641b68b82a39b4da9f&type=3#Speaking");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(0, 0, 0);
    background-size: 50% 100%;
    color: rgba(27, 27, 27, 0);
    overflow: visible;
}

#SFXSlider #unity-drag-container {
    background-color: rgb(0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

#SFXSlider #unity-tracker {
    flex-grow: 1;
    background-color: rgb(139, 47, 47);
    position: relative;
    top: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

#SFXSlider #unity-dragger {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    width: 100px;
    height: 100px;
    top: -10px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    background-image: url("project://database/Assets/Prefabs/UI/Option%20Menu/handle-icon.png?fileID=21300000&guid=531c45b5b88a12041b944baaa067dcd4&type=3#handle-icon");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(0, 0, 0);
    left: auto;
    right: auto;
    align-self: auto;
    align-content: flex-start;
    align-items: stretch;
}

#MusicSlider Label {
    display: flex;
    background-image: url("project://database/Assets/UI/Images/Music%202.png?fileID=21300000&guid=2b02c46030dcf584d89d64b0db73532b&type=3#Music 2");
    background-size: 50% 100%;
    -unity-background-image-tint-color: rgb(0, 0, 0);
    color: rgba(27, 27, 27, 0);
    background-color: rgba(0, 0, 0, 0);
}

#MusicSlider #unity-drag-container {
}

#MusicSlider #unity-tracker {
    flex-grow: 1;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    position: relative;
    top: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    background-color: rgb(140, 47, 47);
}

#MusicSlider #unity-dragger {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    width: 100px;
    height: 100px;
    top: -10px;
    background-image: url("project://database/Assets/Prefabs/UI/Option%20Menu/handle-icon.png?fileID=21300000&guid=531c45b5b88a12041b944baaa067dcd4&type=3#handle-icon");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(0, 0, 0);
}
